# Top3 local development environment
#
# Copy this file to .env and replace each placeholder with the appropriate
# DEVELOPMENT value.
#
# Never commit .env or any real secret values.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the client and must
# contain only values that are safe to expose in the mobile application.
#
# Production values belong in the EAS Production environment, not in this file.

# ---------------------------------------------------------------------------
# Public provider configuration
# ---------------------------------------------------------------------------

EXPO_PUBLIC_TMDB_API_KEY=your_development_tmdb_api_key
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=your_development_google_books_api_key

# ---------------------------------------------------------------------------
# Supabase — Development
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-development-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_development_supabase_publishable_key

# ---------------------------------------------------------------------------
# Google Sign-In
# ---------------------------------------------------------------------------

EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# ---------------------------------------------------------------------------
# Video Games / Twitch
# ---------------------------------------------------------------------------

EXPO_PUBLIC_TWITCH_CLIENT_ID=your_twitch_client_id

# Server-side/local tooling only.
# Do not expose this value through EXPO_PUBLIC_* or client code.
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# ---------------------------------------------------------------------------
# Apple Music / Apple
# ---------------------------------------------------------------------------

# Server-side/local tooling only.
# Private Apple signing keys are stored separately in Supabase Edge Function
# secrets and must never be committed to Git.
APPLE_MUSIC_KEY_ID=your_development_apple_music_key_id
APPLE_TEAM_ID=your_apple_team_id

# ---------------------------------------------------------------------------
# Amplitude — Development
# ---------------------------------------------------------------------------

EXPO_PUBLIC_AMPLITUDE_API_KEY=your_top3_dev_amplitude_api_key

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets
# ---------------------------------------------------------------------------
#
# Edge Function secrets such as Apple private keys, Amplitude secret keys,
# Twitch secrets used by deployed functions, YouTube credentials, and the
# push_notification_webhook secret are configured in the Supabase project.
#
# They are intentionally not duplicated here unless a local development tool
# explicitly requires them.
