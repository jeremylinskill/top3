{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production"
    },
    "closed-test": {
      "environment": "development",
      "distribution": "store",
      "developmentClient": false,
      "channel": "closed-test",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "android-production": {
      "extends": "production",
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
